{
  "name": "timeagent",
  "version": "0.0.1",
  "description": "Log meeting and task time to TargetProcess — cross-platform tray app",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "author": {
    "name": "Hatim Haffane",
    "email": "hatim.haffane@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "keytar": "^7.9.0"
  },
  "build": {
    "appId": "net.omnevo.timeagent",
    "productName": "TimeAgent",
    "files": ["src/**/*", "node_modules/**/*"],
    "publish": [
      {
        "provider": "github",
        "owner": "hatimox",
        "repo": "TimeAgent",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }, { "target": "zip", "arch": ["x64", "arm64"] }]
    },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage", "deb"], "category": "Utility" }
  }
}
